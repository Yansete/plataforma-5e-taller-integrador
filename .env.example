# Copiar este archivo como .env (cp .env.example .env). El archivo .env no se sube al repositorio.
# Valores solo para desarrollo local: no reutilizar esta contraseña en ningún servidor.

# Usuario, contraseña y nombre de la base de datos que crea el contenedor de PostgreSQL al iniciarse por primera vez.
POSTGRES_USER=plataforma5e
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=plataforma5e

# Puerto del equipo en el que se expone PostgreSQL. Cambiarlo si ya hay otro PostgreSQL usando el 5432.
POSTGRES_PORT=5432

# Cadena de conexión desde el equipo (para el futuro backend o un cliente SQL). Debe coincidir con los valores anteriores.
# Las migraciones (dbmate) no la usan: construyen su propia conexión dentro de Docker.
DATABASE_URL=postgres://plataforma5e:cambiar-en-local@localhost:5432/plataforma5e?sslmode=disable

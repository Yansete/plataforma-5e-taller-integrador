  "components": {
    "schemas": {
      "DecisionRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "texto": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Texto"
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "DecisionRequest"
      },
      "ExportacionRequest": {
        "properties": {
          "formato": {
            "type": "string",
            "title": "Formato"
          }
        },
        "type": "object",
        "required": [
          "formato"
        ],
        "title": "ExportacionRequest"
      },
      "GeneracionRespuesta": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "api_demo",
            "title": "Mode"
          },
          "notice": {
            "type": "string",
            "title": "Notice"
          },
          "request": {
            "additionalProperties": true,
            "type": "object",
            "title": "Request"
          },
          "resources": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Resources"
          },
          "available": {
            "type": "integer",
            "title": "Available"
          },
          "fragments": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Fragments"
          },
          "documents": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Documents"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "notice",
          "request",
          "resources",
          "available",
          "fragments",
          "documents"
        ],
        "title": "GeneracionRespuesta"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SolicitudIntegrada": {
        "properties": {
          "unidad_id": {
            "type": "string",
            "title": "Unidad Id",
            "description": "Identificador de la unidad académica curricular (ej. u2)."
          },
          "resultado_aprendizaje_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resultado Aprendizaje Id",
            "description": "Código del resultado de aprendizaje específico a cubrir (ej. ra-2-1)."
          },
          "etapa_5e": {
            "type": "string",
            "enum": [
              "engage",
              "explore",
              "explain",
              "elaborate",
              "evaluate"
            ],
            "title": "Etapa 5E",
            "description": "Etapa instruccional del modelo pedagógico 5E solicitada."
          },
          "tipo_recurso": {
            "type": "string",
            "title": "Tipo Recurso",
            "description": "Subtipo de recurso didáctico a producir (ej. item_opcion_multiple, pregunta_detonante)."
          },
          "cantidad": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Cantidad",
            "description": "Número de variantes o instancias de recursos a generar.",
            "default": 1
          },
          "dificultad": {
            "type": "string",
            "enum": [
              "basica",
              "intermedia",
              "avanzada"
            ],
            "title": "Dificultad",
            "description": "Nivel de complejidad cognitiva estimada para el recurso.",
            "default": "intermedia"
          },
          "alternativas": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 3.0,
            "title": "Alternativas",
            "description": "Cantidad de opciones de respuesta a generar en recursos de evaluación.",
            "default": 4
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "description": "Cantidad máxima de fragmentos contextuales a recuperar de la base vectorial.",
            "default": 10
          },
          "umbral_evidencia": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Umbral Evidencia",
            "description": "Umbral mínimo de similitud semántica requerido para admitir un fragmento.",
            "default": 0.6
          },
          "indicaciones": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Indicaciones",
            "description": "Instrucciones docentes complementarias para guiar el enfoque pedagógico.",
            "default": ""
          },
          "publico_objetivo": {
            "type": "string",
            "maxLength": 200,
            "title": "Publico Objetivo",
            "default": ""
          },
          "competencia": {
            "type": "string",
            "maxLength": 200,
            "title": "Competencia",
            "default": ""
          },
          "modalidades": {
            "items": {
              "type": "string",
              "enum": [
                "Textual",
                "Gamificado",
                "Multimedia",
                "Kinestésico"
              ]
            },
            "type": "array",
            "maxItems": 4,
            "title": "Modalidades"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "unidad_id",
          "etapa_5e",
          "tipo_recurso"
        ],
        "title": "SolicitudIntegrada"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
